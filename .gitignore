# ═══════════════════════════════════════════════════════════
# AI Akıllı Yemekhane Asistan Sistemi — .gitignore
# ═══════════════════════════════════════════════════════════

# ─── API Keys & Environment ────────────────────────────────
.env

# ─── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
venv/
env/
.venv/
.pytest_cache/
.mypy_cache/
pyrightconfig.json

# ─── ML Model Files (large binaries) ──────────────────────
*.pt
*.pth
ai_yemekhane/models_data/*.joblib
ai_yemekhane/models_data/*.joblib.backup_*
ai_yemekhane/models_data/*.json
!ai_yemekhane/models_data/.gitkeep

# ─── Training Datasets (large, downloadable) ──────────────
ai_yemekhane/datasets/
archive/

# ─── Training Runs (reproducible) ─────────────────────────
ai_yemekhane/runs/

# ─── Database (runtime-generated) ─────────────────────────
*.db
*.db-journal
*.sqlite3

# ─── User Uploads (runtime) ───────────────────────────────
ai_yemekhane/uploads/
!ai_yemekhane/uploads/.gitkeep

# ─── Node / Mobile App ────────────────────────────────────
node_modules/
.expo/
*.lock
npm-debug.log*

# ─── IDE ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Temp & Backup Files ──────────────────────────────────
temp_*
tmp_*
*.backup
_backup_*/
_archive*/