# ============================================
# AI Akıllı Yemekhane Asistan Sistemi
# Ortam Değişkenleri Şablonu
# ============================================
# Bu dosyayı kopyalayıp .env olarak adlandırın
# ve kendi değerlerinizi girin.

# Uygulama ayarları
SECRET_KEY=buraya-guclu-bir-anahtar-yazin
DEBUG=True
APP_ENV=development

# Veritabanı (varsayılan: SQLite)
DATABASE_URL=sqlite:///yemekhane.db
# PostgreSQL kullanmak için:
# DATABASE_URL=postgresql://user:password@localhost:5432/yemekhane

# Google Gemini API Anahtarı (Chatbot modülü için)
GEMINI_API_KEY=buraya-gemini-api-anahtarinizi-yazin

# Yönetici Panel Şifresi
ADMIN_PASSWORD=admin123

# Sunucu ayarları
HOST=0.0.0.0
PORT=8001

# CORS whitelist (virgülle ayırın). Bosh bırakılırsa dev modda * (credentialsız),
# prod modda sadece localhost kabul edilir.
# Örnek: CORS_ORIGINS=https://yemekhane.okul.edu.tr,https://mobil.okul.edu.tr
CORS_ORIGINS=

